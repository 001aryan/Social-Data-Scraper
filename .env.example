# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL"

# Security JWT token generation signatures
JWT_SECRET="YOUR_JWT_SECRET"
JWT_REFRESH_SECRET="YOUR_JWT_REFRESH_SECRET"

# Real-world API & Scraper proxy credentials (optional fallbacks)
YOUTUBE_API_KEY=""
TWITTER_BEARER_TOKEN=""
SCRAPINGBEE_API_KEY=""

# Client-visible API bearer token for demo code templates (Vite)
VITE_API_BEARER_TOKEN=""

# Client-visible Stripe webhook signing secret for demo UI (Vite)
VITE_STRIPE_WEBHOOK_SECRET=""

# Client-visible integration defaults for demo UI (Vite)
VITE_SLACK_WEBHOOK_URL=""
VITE_SLACK_CHANNEL=""
VITE_WEBHOOK_AUTH_HEADER=""
VITE_NOTION_API_TOKEN=""
VITE_NOTION_DATABASE_ID=""

# Optional production Redis list queue instance URI
# REDIS_URL="redis://localhost:6379"

